# Copy to ~/.claude/channels/whatsapp/.env and fill in. Never commit the real file.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Your Twilio WhatsApp sender in +country format (the sandbox number while testing)
TWILIO_WHATSAPP_FROM=+14155238886
# The exact public URL you give Twilio as the "When a message comes in" webhook.
# Its path must end in the path the server listens on (here /whatsapp).
PUBLIC_URL=https://your-tunnel.example.com/whatsapp
# Local port your tunnel forwards to (the server binds 127.0.0.1 only)
PORT=8790
